# ===== Cấu hình server =====
PORT=3000

# ===== Cấu hình JWT (dùng từ Bước 4) =====
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_DAYS=3

# ===== Cấu hình Gmail SMTP (dùng từ Bước 3) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_APP_PASSWORD=your_gmail_app_password

# ===== Địa chỉ gốc của ứng dụng (dùng để tạo link verify trong email) =====
APP_BASE_URL=http://localhost:3000
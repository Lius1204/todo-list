{
    "name": "todo-list-website",
    "version": "1.0.0",
    "private": true,
    "description": "Todo List website - Node.js HTTP + CSV storage + JWT auth + Gmail SMTP verification",
    "type": "module",
    "main": "backend/src/server.js",
    "scripts": {
        "start": "node backend/src/server.js",
        "dev": "node --watch backend/src/server.js",
        "seed": "node backend/scripts/seedUsers.js",
        "check": "node backend/scripts/checkSmoke.js",
        "test:csv": "node backend/scripts/testCsvRoundTrip.js",
        "test:utils": "node backend/scripts/testUtils.js",
        "test:signup": "node backend/scripts/testSignupFlow.js",
        "test:login": "node backend/scripts/testLoginFlow.js",
        "test:tasks": "node backend/scripts/testTaskFlow.js",
        "test:frontend": "node backend/scripts/testFrontendAssets.js",
        "test:seed": "node backend/scripts/testSeedEmailCheck.js",
        "test:all": "npm run test:csv && npm run test:utils && npm run test:signup && npm run test:login && npm run test:tasks && npm run test:frontend && npm run test:seed"
    },
    "engines": {
        "node": ">=20.12.0"
    },
    "dependencies": {
        "csv-parse": "^7.0.3",
        "csv-stringify": "^6.9.0",
        "jsonwebtoken": "^9.0.3",
        "nodemailer": "^10.1.0"
    }
}